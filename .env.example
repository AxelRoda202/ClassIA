# Variables de entorno para Aula IA
# Copia este archivo a .env y configura tus claves.
# No subas el archivo .env al control de versiones.

# --- Gemini (proveedor principal) ---
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aquí
GEMINI_MODEL=gemini-3.8-flash

# --- NVIDIA NIM (proveedor directo, compatible con OpenAI) ---
# Obtén la clave en: https://build.nvidia.com/settings
# La clave se lee sólo de esta variable. Nunca la subas al repositorio.
# El proveedor se omite si falta la clave o si no hay modelos configurados.
NVIDIA_API_KEY=
# URL oficial del endpoint alojado. No requiere OmniRoute ni OpenRouter.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Modelo preferido y candidatos separados por comas, en orden de intento.
# Son CANDIDATOS: aparecer en el catálogo no garantiza acceso, gratuidad,
# compatibilidad con JSON ni calidad educativa en español. Verificalos con:
#   python tools/diagnostico_nvidia.py --modelo MODELO --etapa lote_ejercicios
# Modelos documentados para evaluar (no verificados por ClassIA):
#   nvidia/llama-3.3-nemotron-super-49b-v1.5
#   meta/llama-3.3-70b-instruct
#   nvidia/nemotron-3-super-120b-a12b
# Algunas fichas oficiales marcan el free endpoint como deprecado. Consultá
# el catálogo de tu cuenta antes de habilitar un modelo.
NVIDIA_MODEL=
NVIDIA_MODELS=
# Formato de salida: guided_json (recomendado por NIM), json_object o text.
# guided_json usa nvext.guided_json con el esquema real de la etapa.
NVIDIA_RESPONSE_FORMAT=guided_json

# --- Groq (proveedor directo, compatible con OpenAI) ---
# Obtén la clave en: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Candidatos a evaluar. No se habilita ninguno por defecto.
#   openai/gpt-oss-120b
#   openai/gpt-oss-20b
GROQ_MODEL=
GROQ_MODELS=
# Formato: json_object (predeterminado), json_schema (experimental) o text.
GROQ_RESPONSE_FORMAT=json_object

# --- OpenRouter (proveedor alternativo) ---
# Obtén tu clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=tu_clave_de_openrouter_aquí
# Modelo preferido: se intenta primero.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Candidatos de respaldo, separados por comas. Deben ser gratuitos y admitir
# salida estructurada. Verificalos con:
#   python tools/diagnostico_openrouter_json.py --catalogo
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3.5-super-vl:free
# Formato de salida: json_schema (recomendado) o json_object (respaldo).
# OPENROUTER_RESPONSE_FORMAT=json_schema

# --- OmniRoute (opcional, no implementado en el MVP) ---
# OMNIROUTE_BASE_URL=http://tu-servidor-omniroute:puerto
# OMNIROUTE_API_KEY=tu_clave_de_omniroute
# OMNIROUTE_MODEL=tu_modelo

# --- Orden de proveedores ---
# Se intentan en el orden indicado, separados por comas.
# Valores válidos: gemini, nvidia, groq, openrouter, omniroute
# Los proveedores sin clave o sin modelos candidatos se omiten.
# Para probar sólo OpenRouter (sin Gemini), usá: openrouter
AI_PROVIDER_ORDER=gemini,nvidia,groq,openrouter

# --- Límites ---
# Tiempo máximo de espera de una solicitud HTTP individual (segundos).
TIMEOUT_SEGUNDOS=60
MAX_REINTENTOS=2
TOKEN_MAX_SALIDA=8192
# Tiempo máximo para las etapas que llaman a la IA (segundos).
# El ensamblado local y la construcción del PDF se terminan aunque se
# alcance este límite, para no perder el contenido ya generado.
# Valor recomendado actual: 1200 (20 minutos).
TIEMPO_MAX_GENERACION_SEGUNDOS=1200

# --- Modo demostración (1 = activar, 0 = desactivar) ---
# Genera material de ejemplo sin llamar a ninguna API.
AULA_IA_DEMO=0

# --- Generación de imágenes externas (IA) ---
# Habilita o deshabilita la generación de imágenes externas mediante IA.
# Valor: 1 = activar, 0 = desactivar (predeterminado: desactivado por seguridad de costes)
IMAGE_GENERATION_ENABLED=0

# Proveedor de imágenes: "pollinations" es el único implementado actualmente.
IMAGE_PROVIDER=pollinations

# Clave de Pollinations para gen.pollinations.ai.
# El endpoint actual exige una clave secreta (sk_...) para generar y consume
# Pollen del saldo. No la subas al control de versiones.
POLLINATIONS_API_KEY=

# Modelo de imagen de Pollinations (ID canónico del catálogo).
# Verificalo sin generar con: python tools/probar_pollinations.py
#
# Relación precio/calidad (1 Pollen = 1 USD; precios del catálogo):
# - black-forest-labs/flux.1-schnell: 0.002/imagen. Barato, pero flojo
#   para mapas, diagramas o cualquier imagen con texto.
# - black-forest-labs/flux.2-klein-4b: 0.005/imagen. Mejora general
#   económica; no garantiza texto legible.
# - qwen/qwen-image-2.1: ~0.0157/imagen 1024x768. Recomendado para
#   mapas/diagramas con texto: el catálogo declara text rendering preciso.
# - ideogram-ai/ideogram-v4-turbo: 0.03/imagen. Mejor tipografía, más caro.
#
# Para probar un modelo sin editar este archivo:
#   python tools/probar_pollinations.py --generar-una \
#     --confirmar-posible-consumo --modelo qwen/qwen-image-2.1 \
#     --ancho 1024 --alto 768
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
# Alternativa clásica sin clave (otro endpoint, otro modelo y límites):
# https://image.pollinations.ai/prompt/{prompt} (máx. 768x768, JPEG).
# ClassIA usa gen.pollinations.ai/image/{prompt}.

# Máximo de imágenes externas por documento (predeterminado: 2)
MAX_EXTERNAL_IMAGES_PER_PDF=2

# Modo de bajo coste: si es 1, sólo se permiten los modelos de la lista
# interna de gen.pollinations.ai declarados de bajo coste (incluye
# flux.1-schnell, flux.2-klein-4b, z-image-turbo y qwen-image-2.1).
# Ojo: gen.pollinations.ai descuenta Pollen incluso en modelos marcados
# como paid_only=false. Este interruptor NO hace que una imagen sea gratis.
STRICT_FREE_IMAGE_MODE=1
